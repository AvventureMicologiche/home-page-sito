{
  "$description": "apple.com, measured tokens. Unofficial analysis. Not affiliated with or endorsed by Apple. Trademarks belong to their owners. Format: W3C Design Tokens (DTCG).",
  "font": {
    "$type": "fontFamily",
    "display": { "$value": ["SF Pro Display", "SF Pro Icons", "Helvetica Neue", "Helvetica", "Arial", "sans-serif"] },
    "text": { "$value": ["SF Pro Text", "Myriad Set Pro", "SF Pro Icons", "Helvetica Neue", "Helvetica", "Arial", "sans-serif"] }
  },
  "type": {
    "display": { "$type": "typography", "$value": { "fontFamily": "{font.display}", "fontSize": "clamp(2rem, 1.443rem + 2.286vw, 3.5rem)", "fontWeight": 600, "lineHeight": 1.071, "letterSpacing": "-0.005em" }, "$description": "56px desktop, 32px phone" },
    "h1": { "$type": "typography", "$value": { "fontFamily": "{font.display}", "fontSize": "3rem", "fontWeight": 600, "lineHeight": 1.084, "letterSpacing": "-0.003em" }, "$description": "48px" },
    "h2": { "$type": "typography", "$value": { "fontFamily": "{font.display}", "fontSize": "clamp(2rem, 1.814rem + 0.762vw, 2.5rem)", "fontWeight": 600, "lineHeight": 1, "letterSpacing": "0.004em" }, "$description": "40px desktop, 32px phone" },
    "h3": { "$type": "typography", "$value": { "fontFamily": "{font.display}", "fontSize": "2rem", "fontWeight": 600, "lineHeight": 1.125, "letterSpacing": "0.004em" }, "$description": "32px" },
    "h4": { "$type": "typography", "$value": { "fontFamily": "{font.display}", "fontSize": "clamp(1.1875rem, 0.979rem + 0.857vw, 1.75rem)", "fontWeight": 600, "lineHeight": 1.143, "letterSpacing": "0.007em" }, "$description": "28px desktop, 19px phone" },
    "lead": { "$type": "typography", "$value": { "fontFamily": "{font.text}", "fontSize": "clamp(1.0625rem, 0.97rem + 0.381vw, 1.3125rem)", "fontWeight": 600, "lineHeight": 1.381, "letterSpacing": "0.011em" }, "$description": "21px desktop, 17px phone" },
    "body": { "$type": "typography", "$value": { "fontFamily": "{font.text}", "fontSize": "clamp(0.875rem, 0.805rem + 0.286vw, 1.0625rem)", "fontWeight": 400, "lineHeight": 1.471, "letterSpacing": "-0.022em" }, "$description": "17px desktop, 14px phone" },
    "small": { "$type": "typography", "$value": { "fontFamily": "{font.text}", "fontSize": "0.75rem", "fontWeight": 400, "lineHeight": 1.333, "letterSpacing": "-0.01em" }, "$description": "12px" }
  },
  "color": {
    "$type": "color",
    "background": { "$value": "#ffffff", "$extensions": { "oklch": "oklch(100% 0 0)" } },
    "surface": { "$value": "#f5f5f7", "$extensions": { "oklch": "oklch(97.1% 0.003 286.4)" } },
    "surface-inverse": { "$value": "#000000", "$extensions": { "oklch": "oklch(0% 0 0)" } },
    "text": { "$value": "#1d1d1f", "$extensions": { "oklch": "oklch(23.2% 0.004 286.1)" } },
    "text-muted": { "$value": "#707070", "$extensions": { "oklch": "oklch(54.5% 0 0)" } },
    "text-inverse": { "$value": "#ffffff", "$extensions": { "oklch": "oklch(100% 0 0)" } },
    "action": { "$value": "#0071e3", "$extensions": { "oklch": "oklch(56.3% 0.193 256.2)" } },
    "on-action": { "$value": "#ffffff", "$extensions": { "oklch": "oklch(100% 0 0)" } },
    "action-alt": { "$value": "#2997ff", "$description": "Link on black", "$extensions": { "oklch": "oklch(66.9% 0.181 251.8)" } },
    "accent": { "$value": "#0066cc", "$description": "Outline button on light", "$extensions": { "oklch": "oklch(52.2% 0.177 255.8)" } },
    "border": { "$value": "#d2d2d7", "$extensions": { "oklch": "oklch(86.5% 0.007 286.3)" } }
  },
  "gradient": {
    "brand": { "$type": "gradient", "$value": [ { "color": "rgba(0,0,0,0.5)", "position": 0 }, { "color": "rgba(255,255,255,0)", "position": 1 } ], "$description": "radial-gradient(100% 33% at 0% 100%, ...)" }
  },
  "space": {
    "$type": "dimension",
    "base": { "$value": "2px" }, "4": { "$value": "4px" }, "8": { "$value": "8px" }, "10": { "$value": "10px" }, "12": { "$value": "12px" }, "14": { "$value": "14px" }, "20": { "$value": "20px" }, "22": { "$value": "22px" }, "24": { "$value": "24px" }, "28": { "$value": "28px" }, "32": { "$value": "32px" }, "34": { "$value": "34px" }, "40": { "$value": "40px" }, "90": { "$value": "90px" }, "144": { "$value": "144px" }
  },
  "layout": {
    "container": { "$type": "dimension", "$value": "1260px" },
    "columns": { "$type": "number", "$value": 2 },
    "gutter": { "$type": "dimension", "$value": "20px" }
  },
  "radius": {
    "$type": "dimension",
    "28": { "$value": "28px" }, "round": { "$value": "50%" }, "pill": { "$value": "980px" }, "36": { "$value": "36px" }, "6": { "$value": "6px" }
  },
  "button": {
    "height": { "$type": "dimension", "$value": "44px" },
    "padding": { "$type": "dimension", "$value": "11px 21px 11px 21px" },
    "radius": { "$type": "dimension", "$value": "{radius.pill}" },
    "font-size": { "$type": "dimension", "$value": "17px" },
    "weight": { "$type": "fontWeight", "$value": 400 },
    "tracking": { "$type": "dimension", "$value": "-0.37px" },
    "bg": { "$type": "color", "$value": "{color.action}" },
    "fg": { "$type": "color", "$value": "{color.on-action}" }
  },
  "card": {
    "radius": { "$type": "dimension", "$value": "{radius.28}" },
    "padding": { "$type": "dimension", "$value": "0px" },
    "bg": { "$type": "color", "$value": "{color.background}" }
  },
  "input": {
    "$description": "Inferred: no input field was found on the measured pages.",
    "height": { "$type": "dimension", "$value": "44px" },
    "radius": { "$type": "dimension", "$value": "12px" },
    "border": { "$type": "border", "$value": { "color": "{color.border}", "width": "1px", "style": "solid" } },
    "font-size": { "$type": "dimension", "$value": "17px" }
  },
  "nav": {
    "height": { "$type": "dimension", "$value": "44px" },
    "bg": { "$type": "color", "$value": "rgba(255,255,255,0.80)" },
    "blur": { "$type": "string", "$value": "saturate(1.8) blur(20px)" },
    "link-size": { "$type": "dimension", "$value": "12px" }
  },
  "ease": {
    "brand": { "$type": "cubicBezier", "$value": [0, 0, 0.5, 1] },
    "menu": { "$type": "cubicBezier", "$value": [0.4, 0, 0.6, 1], "$description": "0.24-0.32s on the menu" }
  }
}
